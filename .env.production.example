# Copy to .env.production and replace all example values before deployment.
# Generate each application secret independently with: openssl rand -hex 32
DOMAIN=loyalty.example.com
NEXT_PUBLIC_API_URL=https://loyalty.example.com/api/v1
POSTGRES_DB=cluckclub
POSTGRES_USER=cluck
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
REDEMPTION_QR_SECRET_KEY=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_SECRET
BUSINESS_TIMEZONE=Asia/Kolkata
REDEMPTION_QR_TTL_MINUTES=15
ENVIRONMENT=production
DEVELOPMENT_SPIN_LIMIT=1
COOKIE_SECURE=true
CORS_ORIGINS_RAW=https://loyalty.example.com
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
